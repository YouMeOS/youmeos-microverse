{
  "name": "youmeos-microverse",
  "version": "26.8.20-510",
  "description": "My YouMeOS Microverse Desktop",
  "author": "YouMeOS <contact@youmeos.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/YouMeOS/youmeos-microverse.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -w",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"RENDERER,MAIN,APP\" -c \"cyan,magenta,green\" \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "build:assets": "node -e \"fs.cpSync('src/renderer/icon.png', 'dist/renderer/icon.png'); fs.cpSync('src/main/engine/Caddyfile', 'dist/main/engine/Caddyfile')\"",
    "build": "npm run build:main && npm run build:renderer && npm run build:assets",
    "update:plugins": "bash ../scripts/update-plugins.sh",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/three": "^0.185.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "three": "^0.185.1"
  }
}
