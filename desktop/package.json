{
  "name": "youmeos-microverse",
  "version": "1.0.0",
  "description": "My YouMeOS Microverse Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/YouMeOS/youmeos-microverse.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron .",
    "build": "tsc && node -e \"fs.cpSync('src/renderer/index.html', 'dist/renderer/index.html'); fs.cpSync('src/renderer/styles.css', 'dist/renderer/styles.css'); fs.cpSync('src/renderer/icon.png', 'dist/renderer/icon.png'); fs.cpSync('src/main/engine/Caddyfile', 'dist/main/engine/Caddyfile')\"",
    "update:plugins": "bash ../scripts/update-plugins.sh",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  }
}
