{
  "name": "youmeos-microverse",
  "version": "26.9.3-594",
  "description": "My YouMeOS Microverse Desktop",
  "author": "YouMeOS <contact@youmeos.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/YouMeOS/youmeos-microverse.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -w",
    "dev:electron": "wait-on http://127.0.0.1:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k -p \"[{name}]\" -n \"RENDERER,MAIN,APP\" -c \"cyan,magenta,green\" \"pnpm run dev:renderer\" \"pnpm run dev:main\" \"pnpm run dev:electron\"",
    "build:binaries": "node scripts/download-binaries.mjs",
    "build:main": "tsc",
    "build:renderer": "vite build",
    "build:assets": "node -e \"fs.cpSync('src/renderer/icon.png', 'dist/renderer/icon.png'); fs.cpSync('assets', 'dist/assets', {recursive: true}); fs.cpSync('src/main/engine/Caddyfile', 'dist/main/engine/Caddyfile')\"",
    "build": "pnpm run build:binaries && pnpm run build:main && pnpm run build:renderer && pnpm run build:assets",
    "update:plugins": "bash scripts/update-plugins.sh",
    "package": "electron-builder"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/semver": "^7.8.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "semver": "^7.8.5",
    "three": "^0.185.1",
    "vue": "^3.5.42"
  }
}
