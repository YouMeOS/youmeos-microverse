{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/main/**/*", "src/preload/**/*"],
  "exclude": [
    "node_modules",
    "desktop",
    "blackbox",
    "vendor",
    "data",
    "dist",
    "out"
  ]
}
